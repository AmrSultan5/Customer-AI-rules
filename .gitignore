# Secrets
.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node
node_modules/
dist/

# Data files — keep SQLite out, allow xlsx and data dirs
*.db
golden/
# …except the governance golden/ configs, which are app data, not build output:
# data_loader.GOLDEN_DIR rglobs them and ~74% of the YAML rules live there.
# `databricks sync` honours .gitignore, so without this the deployed app boots
# with the Excel rules but an empty YAML/lineage/tree view.
!rule_agent/backend/data/**/golden/
!rule_agent/backend/data/**/golden/**

# Local tools
.claude/